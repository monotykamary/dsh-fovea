{
  "name": "dsh-fovea",
  "version": "0.4.2",
  "description": "Foveated repository intelligence for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "dsh",
    "cordis",
    "repository",
    "code-graph",
    "ast-grep"
  ],
  "homepage": "https://github.com/monotykamary/dsh-fovea#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fovea.git"
  },
  "bugs": {
    "url": "https://github.com/monotykamary/dsh-fovea/issues"
  },
  "author": "Tom Nguyen",
  "funding": "https://www.patreon.com/cw/alpderps",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/core.d.ts",
      "default": "./lib/core.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run verify",
    "install:local": "node scripts/install-local.mjs",
    "uninstall:local": "node scripts/install-local.mjs --uninstall",
    "prepack": "pnpm run check"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.45.0"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-commands": "^0.1.0-rc.7",
    "@monotykamary/dsh-fs": "^0.1.0-rc.7",
    "@monotykamary/dsh-llm": "^0.1.0-rc.7",
    "@monotykamary/dsh-skill": "^0.1.0-rc.7",
    "@monotykamary/dsh-spill": "^0.1.0-rc.7",
    "@monotykamary/dsh-subprocess": "^0.1.0-rc.7",
    "@monotykamary/dsh-system-prompt": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@monotykamary/dsh-commands": {
      "optional": true
    },
    "@monotykamary/dsh-skill": {
      "optional": true
    },
    "@monotykamary/dsh-spill": {
      "optional": true
    }
  },
  "devDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-commands": "^0.1.0-rc.7",
    "@monotykamary/dsh-fs": "^0.1.0-rc.7",
    "@monotykamary/dsh-fs-local": "^0.1.0-rc.7",
    "@monotykamary/dsh-llm": "^0.1.0-rc.7",
    "@monotykamary/dsh-skill": "^0.1.0-rc.7",
    "@monotykamary/dsh-spill": "^0.1.0-rc.7",
    "@monotykamary/dsh-spill-local": "^0.1.0-rc.7",
    "@monotykamary/dsh-subprocess": "^0.1.0-rc.7",
    "@monotykamary/dsh-subprocess-local": "^0.1.0-rc.7",
    "@monotykamary/dsh-system-prompt": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
