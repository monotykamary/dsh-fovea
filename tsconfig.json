{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2024"],
    "strict": true, "noImplicitOverride": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "isolatedModules": true, "skipLibCheck": true, "preserveSymlinks": true,
    "resolveJsonModule": true, "rootDir": "src", "outDir": "lib/types",
    "declaration": true, "declarationMap": false, "emitDeclarationOnly": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
